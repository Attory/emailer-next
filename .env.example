# Placeholder-only example. Copy locally and supply non-production development
# values in an ignored file. Never put credentials or private data in Git.

APP_ENV=dev
APP_DEBUG=0
APP_URL=https://emailer.example.test
APP_TIMEZONE=UTC

# Intentionally empty in Phase 0. Phase 1 will document a local-only MariaDB DSN.
DATABASE_URL=

# Production should point outside public/ and preferably outside the release directory.
EMAILER_PRIVATE_DIR=/srv/emailer-private
EMAILER_SECRET_KEY_FILE=/etc/emailer/master.key

# Development/test uses Mailpit. Production mail configuration is entered through
# the first-run wizard and stored encrypted; do not put a real SMTP password here.
MAILER_DSN=smtp://mailpit:1025
MESSENGER_TRANSPORT_DSN=doctrine://default
