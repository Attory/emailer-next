[Unit]
Description=Emailer Next supervised update for %i
After=network.target mariadb.service
ConditionPathIsReadWrite=/srv/emailer/releases
ConditionPathIsDirectory=/var/lib/emailer-candidate/verified-%i

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/lib/emailer-candidate/verified-%i
EnvironmentFile=/etc/emailer/runtime.env
EnvironmentFile=/etc/emailer/update.env
RuntimeDirectory=emailer-update-%i
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/env EMAILER_RUNTIME_DIR=/run/emailer-update-%i /usr/bin/php /var/lib/emailer-candidate/verified-%i/bin/console emailer:release:update /var/lib/emailer-candidate/emailer-next-%i.zip --source-package=/var/lib/emailer-candidate/emailer-next-${EMAILER_UPDATE_SOURCE_VERSION}.zip --no-interaction --approved-target=%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Complete recovery atomically restores private keys and runtime configuration.
ReadWritePaths=/srv/emailer/releases /var/lib/emailer/private /var/backups/emailer /run/emailer-update-%i /var/lib/emailer/native-update-recovery /var/lib/emailer/keys /etc/emailer
ReadOnlyPaths=/var/lib/emailer-candidate /etc/emailer/release-signing.pub

[Install]
WantedBy=multi-user.target
