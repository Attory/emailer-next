<VirtualHost *:443>
    ServerName emailer.example.test
    DocumentRoot /srv/emailer/releases/current/public

    <Directory /srv/emailer/releases/current/public>
        Options -Indexes -ExecCGI -Includes
        AllowOverride None
        Require all granted
        FallbackResource /index.php
    </Directory>

    <Files "index.php">
        SetHandler "proxy:unix:/run/php/emailer.sock|fcgi://localhost/"
    </Files>

    <FilesMatch "^(?!index\.php$).+\.php$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <DirectoryMatch "/\.">
        Require all denied
    </DirectoryMatch>
</VirtualHost>
