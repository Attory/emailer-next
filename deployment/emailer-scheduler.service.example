[Unit]
Description=Emailer Next scheduler run
After=network.target mariadb.service

[Service]
Type=oneshot
User=emailer
Group=emailer
WorkingDirectory=/srv/emailer/releases/current
EnvironmentFile=/etc/emailer/runtime.env
ExecStart=/usr/bin/php /srv/emailer/releases/current/bin/console emailer:scheduler:run
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/emailer/private /var/backups/emailer
