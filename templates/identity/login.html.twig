{% extends 'base.html.twig' %}

{% block title %}Sign in — Emailer Next{% endblock %}

{% block body %}
<main class="auth-shell">
    <h1>Sign in</h1>
    {% if login_error %}<p class="alert" role="alert">Authentication failed.</p>{% endif %}
    <form method="post" action="{{ path('identity_login') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('identity-login') }}">
        <label>Email <input type="email" name="login_identifier" value="{{ last_login }}" autocomplete="username" required></label>
        <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
        <label>Authenticator or recovery code <input type="text" name="mfa_code" autocomplete="one-time-code" inputmode="numeric"></label>
        <button type="submit">Sign in</button>
    </form>
    <p><a href="{{ path('identity_password_reset_request') }}">Forgot your password?</a></p>
</main>
{% endblock %}
