{% extends 'base.html.twig' %}
{% block title %}Choose a new password — Emailer Next{% endblock %}
{% block body %}
<main class="auth-shell">
    <h1>Choose a new password</h1>
    <form method="post" data-reset-token-form>
        <input type="hidden" name="_token" value="{{ csrf_token('password-reset-' ~ selector) }}">
        <label>Reset code <input type="password" name="reset_token" autocomplete="one-time-code" required data-reset-token></label>
        <label>New password <input type="password" name="password" autocomplete="new-password" minlength="15" maxlength="256" required></label>
        <label>Confirm password <input type="password" name="password_confirmation" autocomplete="new-password" minlength="15" maxlength="256" required></label>
        <button type="submit">Reset password</button>
    </form>
</main>
<script src="{{ asset('reset-token.js') }}" defer></script>
{% endblock %}
