{% extends 'base.html.twig' %}
{% block title %}Password recovery — Emailer Next{% endblock %}
{% block body %}
<main class="auth-shell">
    <h1>Password recovery</h1>
    <p>Enter your individual account email. The response is the same for every request.</p>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('password-reset-request') }}">
        <label>Email <input type="email" name="login_identifier" autocomplete="username" required></label>
        <button type="submit">Request reset</button>
    </form>
</main>
{% endblock %}
