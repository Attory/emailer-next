<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Emailer Next{% endblock %}</title>
        <link rel="icon" href="{{ asset('identity/favicon.ico') }}" sizes="any">
        <link rel="icon" href="{{ asset('identity/favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('identity/icon-180.png') }}" sizes="180x180">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block shell_assets %}{% endblock %}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body{% block body_attributes %}{% endblock %}>
        {% block body %}{% endblock %}
        <footer class="source-footer"><a href="{{ ripe_source_url }}">Ripe source code and AGPL-3.0-or-later license</a></footer>
    </body>
</html>
