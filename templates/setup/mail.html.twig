{% extends 'setup/layout.html.twig' %}
{% block title %}Mail configuration{% endblock %}
{% block body %}
<main>
    <h1>Mail transport and sender identity</h1>
    <p>Phase 3 accepts only local Mailpit at port 1025. Live or production SMTP targets are rejected. Any supplied synthetic credential is encrypted and never redisplayed.</p>
    <form method="post" action="{{ path('setup_mail') }}" autocomplete="off">
        <input type="hidden" name="_token" value="{{ csrf_token('setup-mail') }}">
        <label>Host <input name="host" value="mailpit" required></label>
        <label>Port <input name="port" type="number" value="1025" required></label>
        <label>Encryption <select name="encryption"><option value="none">Mailpit local test</option></select></label>
        <label>Username <input name="username" autocomplete="off"></label>
        <label>Synthetic credential <input name="password" type="password" autocomplete="new-password"></label>
        <label>Sender address <input name="sender_address" type="email" value="phase3-sender@example.test" required></label>
        <label>Sender name <input name="sender_name" value="Emailer Next Test" maxlength="160" required></label>
        <label>Reply-to address <input name="reply_to" type="email"></label>
        <p>TLS peer verification is mandatory and cannot be disabled.</p>
        <button type="submit">Send synthetic Mailpit test and save</button>
    </form>
</main>
{% endblock %}
