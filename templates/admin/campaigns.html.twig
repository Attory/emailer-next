{% extends 'admin/layout.html.twig' %}
{% block title %}Campaigns · Emailer Next{% endblock %}
{% block javascripts %}<script type="module" src="{{ asset('campaign-editor.js') }}"></script>{% endblock %}
{% block admin_body %}
{% set values = form_values|default({}) %}
<div class="page-heading"><div><p class="eyebrow">Make something worth opening</p><h1>Your campaigns.</h1><p><a href="{{ path('admin_campaign_guide') }}">How to create and edit a newsletter</a></p><p class="muted">Prepare a newsletter, check it, then send when you’re ready.</p></div>{% if is_granted('ROLE_OPERATOR') %}<a class="button" href="#compose">Create a campaign <span aria-hidden="true">↓</span></a>{% endif %}</div>
<section class="panel" aria-labelledby="campaign-history">
<div class="section-header"><h2 id="campaign-history">Campaign history</h2><span class="muted">{{ campaigns|length }} campaigns</span></div>
{% if campaigns %}<table><thead><tr><th scope="col">Newsletter</th><th scope="col">Status</th><th scope="col">Audience</th><th scope="col">Accepted</th><th scope="col">Needs attention</th><th scope="col">Updated</th></tr></thead><tbody>
{% for campaign in campaigns %}<tr><td><a href="{{ path('admin_campaign', {id: campaign.id}) }}">{{ campaign.name ?: 'Untitled campaign draft' }}</a></td><td><span class="status-pill" data-state="{{ campaign.state }}">{{ campaign.state|replace({'queueing':'Preparing', 'sending':'Sending', 'review':'Ready for review'})|capitalize }}</span></td><td class="tabular">{{ campaign.recipient_count }}</td><td class="tabular">{{ campaign.accepted_count|default(0) }}</td><td class="tabular">{{ campaign.failure_count|default(0) }}</td><td><small>{{ campaign.updated_at|date('d M, H:i') }}</small></td></tr>{% endfor %}
</tbody></table>{% else %}<div class="empty-state"><h2>Your first newsletter starts here.</h2><p class="muted">Choose a list and a template below. You can preview and test everything before sending.</p></div>{% endif %}
</section>
{% if is_granted('ROLE_OPERATOR') %}
<section class="panel" id="compose"><h2>Create a campaign</h2>
{% include 'admin/_campaign-editor.html.twig' with {campaign: null, values: values, selected_template: selected_template|default(''), selected_list: selected_list|default('')} %}
</section>
{% endif %}
{% endblock %}
