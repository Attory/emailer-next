{% extends 'admin/layout.html.twig' %}
{% block title %}{{ operation == 'edit' ? 'Edit' : 'Duplicate' }} list — Emailer Next{% endblock %}
{% block admin_body %}
<p><a href="{{ path('admin_list', {id: list.id}) }}">← {{ list.name }}</a></p>
<h1>{{ operation == 'edit' ? 'Edit list' : 'Duplicate list' }}</h1>
{% if operation == 'duplicate' %}<p>The new list will contain the same {{ list.member_count }} members. It shares the existing contact records and their global unsubscribe status.</p>{% endif %}
<form method="post" action="{{ path('admin_list_' ~ operation, {id: list.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('list-' ~ operation ~ '-' ~ list.id) }}">
    <label>List name <input name="name" value="{{ operation == 'edit' ? list.name : '' }}" maxlength="160" required></label>
    <button type="submit">{{ operation == 'edit' ? 'Save list name' : 'Duplicate list' }}</button>
</form>
<p><a href="{{ path('admin_list', {id: list.id}) }}">Manage members</a></p>
{% endblock %}
