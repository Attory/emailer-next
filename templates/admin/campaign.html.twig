{% extends 'admin/layout.html.twig' %}
{% block title %}Campaign · Emailer Next{% endblock %}
{% block admin_body %}
<p><a href="{{ path('admin_campaigns') }}">← Campaigns</a></p>
<h1>{{ campaign.name }}</h1>
<dl><dt>State</dt><dd>{{ campaign.state }}</dd><dt>Audience snapshot</dt><dd>{{ campaign.recipient_count }}</dd><dt>Approved</dt><dd>{{ campaign.approved_at|default('Not yet') }}</dd><dt>Scheduled</dt><dd>{{ campaign.scheduled_at|default('Not scheduled') }}</dd></dl>
{% if campaign.latest_test %}<p>Latest test: {{ campaign.latest_test.state }}{% if campaign.latest_test.failure_class %} ({{ campaign.latest_test.failure_class }}){% endif %}</p>{% endif %}
{% if campaign.pending_import %}
<section aria-labelledby="upload-review"><h2 id="upload-review">Review uploaded recipients</h2>
<p>Valid {{ campaign.pending_import.valid_count }}; duplicate {{ campaign.pending_import.duplicate_count }}; unsubscribed {{ campaign.pending_import.suppressed_count }}; invalid {{ campaign.pending_import.invalid_count }}; rejected {{ campaign.pending_import.rejected_count }}.</p>
<p>These recipients have not been added to the list yet.</p>
<form method="post" action="{{ path('admin_campaign_import_commit', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-import-' ~ campaign.id) }}"><button type="submit">Commit reviewed recipients</button></form>
<a href="{{ path('admin_import_details', {id: campaign.pending_import.id}) }}">Review column mapping and private rejection report</a>
</section>
{% endif %}
<section aria-labelledby="approval-summary">
    <h2 id="approval-summary">Approval summary</h2>
    <dl>
        <dt>Selected audience</dt><dd>{{ campaign.review.selected_count }}</dd>
        <dt>Currently suppressed</dt><dd>{{ campaign.review.suppressed_count }}</dd>
        <dt>Currently eligible</dt><dd>{{ campaign.review.eligible_count }}</dd>
        <dt>Template</dt><dd>{{ campaign.template_name }} version {{ campaign.template_version }}</dd>
        <dt>Sender</dt><dd>{{ campaign.review.sender_name }} &lt;{{ campaign.review.sender_address }}&gt;</dd>
        <dt>Schedule time zone</dt><dd>{{ campaign.review.time_zone }}</dd>
        <dt>Tracking</dt><dd>{{ campaign.review.tracking }}</dd>
        <dt>RSVP</dt><dd>{{ campaign.review.rsvp }}</dd>
        <dt>One-click unsubscribe</dt><dd>{{ campaign.review.one_click }}</dd>
        <dt>Test send</dt><dd>{{ campaign.latest_test ? campaign.latest_test.state : 'Not run' }}</dd>
    </dl>
</section>
{% if is_granted('ROLE_OPERATOR') %}
<div class="actions">
{% if campaign.state in ['draft', 'review'] and not campaign.pending_import %}
    <form method="post" action="{{ path('admin_campaign_test', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-test-' ~ campaign.id) }}"><button>Queue test send</button></form>
{% endif %}
{% if campaign.state == 'draft' and not campaign.pending_import %}<form method="post" action="{{ path('admin_campaign_review', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-review-' ~ campaign.id) }}"><button>Submit for review</button></form>{% endif %}
{% if campaign.state == 'draft' %}<form method="post" action="{{ path('admin_campaign_rsvp', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-rsvp-' ~ campaign.id) }}"><label><input type="checkbox" name="enabled" value="1"{% if campaign.rsvp_enabled %} checked{% endif %}> Enable RSVP for this campaign</label><button>Save RSVP setting</button></form>{% endif %}
{% if campaign.state == 'review' and is_granted('ROLE_ADMINISTRATOR') %}<p><a href="{{ path('admin_reauthenticate', {purpose: 'campaign_approval'}) }}">Re-authenticate before approval</a></p><form method="post" action="{{ path('admin_campaign_approve', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-approve-' ~ campaign.id) }}"><label><input type="checkbox" name="waive_test" value="1"> Audited test waiver</label><button>Approve snapshot</button></form>{% endif %}
{% if campaign.state == 'approved' %}
    <form method="post" action="{{ path('admin_campaign_queue', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-queue-' ~ campaign.id) }}"><button>Queue now</button></form>
    <form method="post" action="{{ path('admin_campaign_schedule', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-schedule-' ~ campaign.id) }}"><label>Schedule <input type="datetime-local" name="scheduled_at" required></label><button>Schedule</button></form>
{% endif %}
{% if campaign.state in ['queueing', 'sending'] %}<form method="post" action="{{ path('admin_campaign_pause', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-pause-' ~ campaign.id) }}"><button>Pause</button></form>{% endif %}
{% if campaign.state == 'paused' %}<form method="post" action="{{ path('admin_campaign_resume', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-resume-' ~ campaign.id) }}"><button>Resume</button></form>{% endif %}
{% if campaign.state in ['approved', 'scheduled', 'queueing', 'sending', 'paused'] %}<form method="post" action="{{ path('admin_campaign_cancel', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-cancel-' ~ campaign.id) }}"><button>Cancel unclaimed deliveries</button></form>{% endif %}
</div>
{% endif %}
<h2>Durable delivery progress</h2>
<table><thead><tr><th scope="col">State</th><th scope="col">Count</th></tr></thead><tbody>{% for row in campaign.delivery_counts %}<tr><td>{{ row.state }}</td><td>{{ row.count }}</td></tr>{% else %}<tr><td colspan="2">No delivery ledger records yet.</td></tr>{% endfor %}</tbody></table>
<p>“Accepted” means the configured SMTP transport accepted the message; it does not prove inbox placement.</p>
{% endblock %}
