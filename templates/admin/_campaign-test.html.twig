<form method="post" action="{{ path('admin_campaign_test', {id: campaign.id}) }}" data-campaign-test data-campaign-id="{{ campaign.id }}" data-actor-id="{{ campaign.test_actor_id }}" data-pending="{{ campaign.own_test and not campaign.own_test.terminal ? 'true' : 'false' }}" data-status-url="{{ path('admin_campaign_test_result', {id: campaign.id, testId: campaign.test_request_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-test-' ~ campaign.id) }}"><input type="hidden" name="request_id" value="{{ campaign.test_request_id }}"><p>Test destination: <strong data-test-destination>{{ campaign.test_destination }}</strong></p><p role="status" aria-live="polite" aria-atomic="true" data-test-feedback>{{ campaign.own_test ? campaign.own_test.message : 'Only this address receives the test. No campaign recipients will be sent mail.' }}</p><button data-update-send data-update-original-disabled="{{ campaign.can_test ? 'false' : 'true' }}" aria-describedby="update-send-explanation"{% if not campaign.can_test or update_delivery.blocked or (campaign.own_test and not campaign.own_test.terminal) %} disabled{% endif %}>{{ campaign.own_test and not campaign.own_test.terminal ? 'Sending…' : 'Send a test to myself' }}</button></form>
