{% extends 'base.html.twig' %}
{% block body %}
<header class="admin-header">
    <strong>Emailer Next</strong>
    <nav aria-label="Administration">
        <a href="{{ path('admin_dashboard') }}">Dashboard</a>
        <a href="{{ path('admin_profile') }}">Profile</a>
        <a href="{{ path('admin_sessions') }}">Sessions</a>
        <a href="{{ path('admin_mfa') }}">MFA</a>
        {% if is_granted('ROLE_ADMINISTRATOR') %}<a href="{{ path('admin_users') }}">Users</a>{% endif %}
        {% if is_granted('ROLE_ADMINISTRATOR') %}<a href="{{ path('admin_mail_settings') }}">Mail</a>{% endif %}
        {% if is_granted('ROLE_OPERATOR') %}
            <a href="{{ path('admin_contacts') }}">Contacts</a>
            <a href="{{ path('admin_lists') }}">Lists</a>
            <a href="{{ path('admin_imports') }}">Imports</a>
            <a href="{{ path('admin_suppressions') }}">Suppressions</a>
            <a href="{{ path('admin_templates') }}">Templates</a>
            <a href="{{ path('admin_campaigns') }}">Campaigns</a>
        {% endif %}
        <a href="{{ path('admin_audit') }}">Audit</a>
        <a href="{{ path('admin_analytics') }}">Analytics</a>
        <a href="{{ path('admin_rsvp') }}">RSVP</a>
        <a href="{{ path('admin_doctor') }}">Doctor</a>
        {% if is_granted('ROLE_ADMINISTRATOR') %}<a href="{{ path('admin_retention') }}">Retention</a>{% endif %}
        {% if is_granted('ROLE_OWNER') %}<a href="{{ path('admin_backups') }}">Backups</a><a href="{{ path('admin_release') }}">Release</a>{% endif %}
        <form method="post" action="{{ path('admin_logout') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin-logout') }}">
            <button type="submit">Sign out</button>
        </form>
    </nav>
</header>
<main class="admin-content">
    {% set doctor_findings = app.request.attributes.get('doctor_active_findings')|default([]) %}
    {% if doctor_findings|filter(finding => finding.severity == 'critical')|length > 0 %}
        <aside class="alert" role="alert">
            <strong>Critical operational finding.</strong>
            {% for finding in doctor_findings|filter(finding => finding.severity == 'critical') %}{{ finding.summary }}{% if finding.sending_blocked %} Sending is blocked.{% endif %} {% endfor %}
            <a href="{{ path('admin_doctor') }}">Open Configuration Doctor</a>
        </aside>
    {% endif %}
    {% for message in app.flashes('error') %}<p class="alert" role="alert">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('success') %}<p class="alert success" role="status">{{ message }}</p>{% endfor %}
    {% block admin_body %}{% endblock %}
</main>
{% endblock %}
