{% extends 'base.html.twig' %}
{# Appearance assets live in shell_assets so pages that replace the javascripts block keep the skin and its control. #}
{% block shell_assets %}
        <link rel="stylesheet" href="{{ asset('styles/skins.css') }}">
        <link rel="stylesheet" href="{{ path('admin_appearance_tokens') }}">
        <script type="module" src="{{ asset('appearance.js') }}"></script>
        <script type="module" src="{{ asset('update-status.js') }}"></script>
{% endblock %}
{% block body_attributes %}{% set appearance = app.request.attributes.get('appearance')|default({}) %}{% set skin = appearance.skin|default('classic') %} data-skin="{{ skin in ['classic', 'website', 'studio', 'warm'] ? skin : 'classic' }}" data-motion="{{ appearance.motion|default('system') == 'reduced' ? 'reduced' : 'system' }}"{% if appearance.branding.logo_url|default(null) %} data-brand-logo="present"{% endif %}{% endblock %}
{% block body %}
{% set appearance = app.request.attributes.get('appearance')|default({}) %}
{% set brand_logo = appearance.branding.logo_url|default(null) %}
{% set brand_logo = brand_logo is not null and brand_logo starts with '/' and not (brand_logo starts with '//') ? brand_logo : null %}
<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="admin-header">
    <a class="brand" href="{{ path('admin_dashboard') }}">{% if brand_logo %}<img class="brand-logo" src="{{ brand_logo }}" alt="" width="32" height="32" data-brand-logo-image>{% endif %}<span class="brand-mark" aria-hidden="true">en</span>Emailer Next</a>
    <nav aria-label="Administration">
        {% set current_route = app.request.attributes.get('_route')|default('') %}
        {% for label, route in {'Overview': 'admin_dashboard', 'Campaigns': 'admin_campaigns', 'Lists': 'admin_lists', 'Templates': 'admin_templates', 'Contacts': 'admin_contacts'} %}
            {% if route == 'admin_dashboard' or route == 'admin_campaigns' or is_granted('ROLE_OPERATOR') %}
            <a href="{{ path(route) }}"{% if current_route == route or (route == 'admin_campaigns' and current_route starts with 'admin_campaign') or (route == 'admin_templates' and current_route starts with 'admin_template') or (route == 'admin_lists' and current_route starts with 'admin_list') or (route == 'admin_contacts' and current_route starts with 'admin_contact') %} aria-current="page"{% endif %}>{{ label }}</a>
            {% endif %}
        {% endfor %}
        <details><summary>Settings &amp; tools</summary><div class="tools-menu">
            {% if is_granted('ROLE_ADMINISTRATOR') %}<a href="{{ path('admin_security_settings') }}">Security</a><a href="{{ path('admin_mail_settings') }}">Mail settings</a><a href="{{ path('admin_delivery_settings') }}">Delivery limits</a><a href="{{ path('admin_users') }}">Users</a>{% endif %}
            {% if is_granted('ROLE_OPERATOR') %}<a href="{{ path('admin_imports') }}">Imports</a><a href="{{ path('admin_suppressions') }}">Unsubscribes</a>{% endif %}
            <a href="{{ path('admin_analytics') }}">Analytics</a><a href="{{ path('admin_rsvp') }}">RSVP</a><a href="{{ path('admin_doctor') }}">Doctor</a><a href="{{ path('admin_audit') }}">Audit</a>
            {% if is_granted('ROLE_ADMINISTRATOR') %}<a href="{{ path('admin_retention') }}">Retention</a>{% endif %}
            {% if is_granted('ROLE_OWNER') %}<a href="{{ path('admin_backups') }}">Backups</a><a href="{{ path('admin_release') }}">Release</a>{% endif %}
            <a href="{{ path('admin_campaign_guide') }}">Newsletter guide</a>
            <a href="{{ path('admin_profile') }}">Your profile</a><a href="{{ path('admin_sessions') }}">Sessions</a><a href="{{ path('admin_mfa') }}">MFA</a>
            <form method="post" action="{{ path('admin_logout') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin-logout') }}"><button type="submit" class="secondary">Sign out</button></form>
        </div></details>
    </nav>
    {% include 'admin/_appearance.html.twig' with {appearance: appearance} only %}
</header>
<main id="main-content" class="admin-content" tabindex="-1">
    {% set update_delivery = app.request.attributes.get('update_delivery')|default({blocked: false, message: ''}) %}
    <aside id="update-maintenance-notice" class="alert update-maintenance" role="status" aria-live="polite" aria-atomic="true" data-update-status data-status-url="{{ path('admin_update_status') }}" data-blocked="{{ update_delivery.blocked ? 'true' : 'false' }}"{% if not update_delivery.blocked %} hidden{% endif %}>{{ update_delivery.message }}</aside>
    <p id="update-send-explanation" class="help" data-update-send-explanation{% if not update_delivery.blocked %} hidden{% endif %}>{{ update_delivery.message }}</p>
    {% set doctor_findings = app.request.attributes.get('doctor_active_findings')|default([]) %}
    {% if doctor_findings|filter(finding => finding.severity == 'critical')|length > 0 %}
        <aside class="alert" role="alert">
            <strong>Critical operational finding.</strong>
            {% for finding in doctor_findings|filter(finding => finding.severity == 'critical') %}{{ finding.summary }}{% if finding.sending_blocked %} Sending is blocked.{% endif %} {% endfor %}
            <a href="{{ path('admin_doctor') }}">Open Configuration Doctor</a>
        </aside>
    {% endif %}
    {% for message in app.flashes('error') %}<p class="alert" role="alert">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('success') %}<p class="alert success" role="status">{{ message }}</p>{% endfor %}
    {% block admin_body %}{% endblock %}
</main>
{% endblock %}
