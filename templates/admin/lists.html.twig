{% extends 'admin/layout.html.twig' %}
{% block title %}Lists — Emailer Next{% endblock %}
{% block admin_body %}
<h1>Lists</h1>
<form method="post" action="{{ path('admin_list_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('list-create') }}"><label>Name <input name="name" maxlength="160" required></label><button type="submit">Create list</button></form>
<table><thead><tr><th scope="col">Name</th><th scope="col">Members</th><th scope="col">Membership</th><th scope="col">Archive</th></tr></thead><tbody>
{% for list in lists %}<tr><td>{{ list.name }}</td><td>{{ list.member_count }}</td><td><form method="post" action="{{ path('admin_membership_add', {id: list.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('membership-add-' ~ list.id) }}"><select name="contact_id">{% for contact in contacts %}<option value="{{ contact.id }}">{{ contact.email_display }}</option>{% endfor %}</select><button type="submit">Add</button></form></td><td><form method="post" action="{{ path('admin_list_archive', {id: list.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('list-archive-' ~ list.id) }}"><button type="submit">Archive</button></form></td></tr>{% else %}<tr><td colspan="4">No lists.</td></tr>{% endfor %}
</tbody></table>
{% endblock %}
