{% extends 'admin/layout.html.twig' %}
{% block title %}Lists — Emailer Next{% endblock %}
{% block javascripts %}<script type="module" src="{{ asset('list-create.js') }}"></script>{% endblock %}
{% block admin_body %}
<div class="lists-heading"><button type="button" data-list-create-open hidden>Create new</button><h1>Lists</h1></div>
<p>Open a list to see its members, find contacts, and manage membership. Send to starts a campaign draft for that list.</p>
{% if is_granted('ROLE_ADMINISTRATOR') and security_requires_recent() %}<p><a href="{{ path('admin_reauthenticate', {purpose: 'contact_data_access'}) }}">Re-authenticate to download list CSV files</a>.</p>{% endif %}
<dialog open data-list-create-dialog aria-labelledby="create-list-title">
<h2 id="create-list-title">Create new list</h2>
<p>Create an empty list, upload a CSV, copy existing lists, or combine both. Contacts are added to the new list only; source lists and global unsubscribe rules are unchanged.</p>
<form method="post" enctype="multipart/form-data" action="{{ path('admin_list_create') }}" data-list-create-form>
<input type="hidden" name="_token" value="{{ csrf_token('list-create') }}">
<label>List name <input name="name" maxlength="160" required></label>
<fieldset><legend>Upload CSV (optional)</legend>
<label>Mode <select name="mode"><option value="headered">Headered</option><option value="headerless">Headerless</option></select></label>
<label>Browse <input type="file" name="csv_file" accept="text/csv,.csv"></label>
<p class="help">Upload creates the list, then opens the existing preview and column mapping. Review mismatched, rejected and duplicate rows before committing the CSV.</p>
<button type="submit" name="intent" value="upload">Upload</button>
</fieldset>
<fieldset><legend>Copy from list(s) (optional)</legend>
<label for="list-sources">Source lists</label><select id="list-sources" name="source_lists[]" multiple size="5" data-list-sources aria-describedby="list-source-help">{% for list in lists %}<option value="{{ list.id }}">{{ list.name }} ({{ list.member_count }})</option>{% endfor %}</select>
<p id="list-source-help" class="help">Use Ctrl-click on Windows/Linux or Cmd-click on macOS to select several lists. On mobile, use the list picker or the checkboxes below. Overlapping memberships are added once.</p>
<details data-source-checkboxes hidden><summary>Select with checkboxes</summary>{% for list in lists %}<label><input type="checkbox" value="{{ list.id }}" data-source-choice>{{ list.name }}</label>{% endfor %}</details>
</fieldset>
<div class="dialog-actions"><button type="submit" name="intent" value="create">Create new</button><button type="button" class="secondary" data-list-create-close>Cancel</button></div>
</form></dialog>

<table><thead><tr><th scope="col">Name</th><th scope="col">Members</th><th scope="col">Actions</th></tr></thead><tbody>
{% for list in lists %}
<tr><td><a href="{{ path('admin_list', {id: list.id}) }}">{{ list.name }}</a></td><td>{{ list.member_count }}</td><td>{% include 'admin/_list-actions.html.twig' %}</td></tr>
{% else %}<tr><td colspan="3">No lists.</td></tr>{% endfor %}
</tbody></table>
<p>Archive hides a list from future selection. Contact records and unsubscribe protections remain intact.</p>
{% endblock %}
