{% extends 'admin/layout.html.twig' %}
{% block title %}Edit newsletter · Emailer Next{% endblock %}
{% block admin_body %}
{% set values = form_values ?? {name: campaign.name, lists: campaign.selected_lists, template_version: campaign.template_version_id, messages_per_minute: campaign.messages_per_minute} %}
<div class="page-heading"><div><p class="eyebrow">Newsletter draft</p><h1>Edit {{ campaign.name }}</h1><p class="muted">Save your changes, then send a fresh test before approval.</p></div><a class="button secondary" href="{{ path('admin_campaign', {id: campaign.id}) }}">Back to newsletter</a></div>
<form class="panel" method="post" action="{{ path('admin_campaign_edit', {id: campaign.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('campaign-edit-' ~ campaign.id) }}">
<label>Campaign name<input name="name" value="{{ values.name }}" maxlength="160" required></label>
<fieldset><legend>Recipients</legend><div class="list-choices">{% for list in options.lists %}<label><input type="checkbox" name="lists[]" value="{{ list.id }}"{% if list.id in values.lists %} checked{% endif %}> {{ list.name }} <span class="muted">{{ list.member_count }} members</span></label>{% else %}<p>No active lists. <a href="{{ path('admin_lists') }}">Create a list</a> first.</p>{% endfor %}</div></fieldset>
<label>Template<select name="template_version" required><option value="">Choose a template</option>{% if campaign.template_version_id not in options.templates|column('id') %}<option value="{{ campaign.template_version_id }}"{% if values.template_version == campaign.template_version_id %} selected{% endif %}>{{ campaign.template_name }} · version {{ campaign.template_version }} (currently used; select another if archived)</option>{% endif %}{% for template in options.templates %}<option value="{{ template.id }}"{% if template.id == values.template_version %} selected{% endif %}>{{ template.name }} · version {{ template.version_number }}</option>{% endfor %}</select></label>
<p><a href="{{ path('admin_templates') }}">Edit or create templates</a> in a separate tab, then return here to select the new version.</p>
<label>Messages per minute<input type="number" name="messages_per_minute" value="{{ values.messages_per_minute }}" min="1" max="600" placeholder="{{ campaign.delivery_limits.messages_per_minute }}"><span class="help">Leave blank to use the installation limit. Installation and destination-domain ceilings still apply.</span></label>
<div class="actions"><button>Save draft</button><a class="button secondary" href="{{ path('admin_campaign', {id: campaign.id}) }}">Cancel</a></div>
</form>
{% endblock %}
