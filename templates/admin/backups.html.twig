{% extends 'admin/layout.html.twig' %}
{% block title %}Backups · Emailer Next{% endblock %}
{% block admin_body %}
<h1>Encrypted backups</h1>
<p>Paths and private content are deliberately omitted. Restore remains CLI-only.</p>
<form method="post" action="{{ path('admin_backup_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('backup-create') }}"><button>Create and verify backup</button></form>
<table><thead><tr><th scope="col">ID</th><th scope="col">Status</th><th scope="col">Version</th><th scope="col">Schema</th><th scope="col">Bytes</th><th scope="col">Verified</th></tr></thead><tbody>{% for backup in backups %}<tr><td>{{ backup.id }}</td><td>{{ backup.status }}</td><td>{{ backup.source_version }}</td><td>{{ backup.schema_version }}</td><td>{{ backup.byte_size }}</td><td>{{ backup.verified_at }}</td></tr>{% else %}<tr><td colspan="6">No backup evidence.</td></tr>{% endfor %}</tbody></table>
{% endblock %}
