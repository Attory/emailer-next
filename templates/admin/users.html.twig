{% extends 'admin/layout.html.twig' %}
{% block title %}Users — Emailer Next{% endblock %}
{% block javascripts %}<script type="module" src="{{ asset('mail-settings.js') }}"></script>{% endblock %}
{% block admin_body %}
<h1>Individual administrative accounts</h1>
{% if security_requires_recent() %}<p>Your identity is confirmed when you create, update or delete an account. Confirmation lasts five minutes for user management in this browser.</p>{% endif %}
<table><thead><tr><th scope="col">Account</th><th scope="col">Role</th><th scope="col">Active</th><th scope="col">Actions</th></tr></thead><tbody>
{% for account in users %}<tr><td>{{ account.login_identifier }}</td><td>{{ account.role }}</td><td>{{ account.active ? 'Yes' : 'No' }}</td><td>
<form method="post"{% if security_requires_recent() %} data-mail-settings-confirmation-expires-at-value="{{ confirmation_expires_at }}"{% endif %} action="{{ path('admin_user_update', {id: account.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('admin-user-update-' ~ account.id) }}">
<select name="role" aria-label="Role for {{ account.login_identifier }}">{% for role in roles %}{% if is_granted('ROLE_OWNER') or role.value != 'ROLE_OWNER' %}<option value="{{ role.value }}" {{ role.value == account.role ? 'selected' : '' }}>{{ role.label }}</option>{% endif %}{% endfor %}</select>
<label><input type="checkbox" name="active" value="1" {{ account.active ? 'checked' : '' }}> Active</label>{% if security_requires_recent() %}{% include 'admin/user-confirmation.html.twig' with {confirmation_action: 'Confirm and update'} %}{% endif %}<button type="submit">Update</button></form>
<form method="post"{% if security_requires_recent() %} data-mail-settings-confirmation-expires-at-value="{{ confirmation_expires_at }}"{% endif %} action="{{ path('admin_user_delete', {id: account.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin-user-delete-' ~ account.id) }}">{% if security_requires_recent() %}{% include 'admin/user-confirmation.html.twig' with {confirmation_action: 'Confirm and delete'} %}{% endif %}<button type="submit">Delete</button></form>
</td></tr>{% endfor %}</tbody></table>
<h2>Create account</h2>
<form method="post"{% if security_requires_recent() %} data-mail-settings-confirmation-expires-at-value="{{ confirmation_expires_at }}"{% endif %} action="{{ path('admin_user_create') }}">
<input type="hidden" name="_token" value="{{ csrf_token('admin-user-create') }}">
<label>Email <input type="email" name="login_identifier" value="{{ create_login }}" autocomplete="off" required></label>
<label>Initial password <input type="password" name="password" autocomplete="new-password" minlength="15" maxlength="256" required></label>
<label>Role <select name="role">{% for role in roles %}{% if is_granted('ROLE_OWNER') or role.value != 'ROLE_OWNER' %}<option value="{{ role.value }}"{% if role.value == create_role %} selected{% endif %}>{{ role.label }}</option>{% endif %}{% endfor %}</select></label>
{% if security_requires_recent() %}{% include 'admin/user-confirmation.html.twig' with {confirmation_action: 'Confirm and create account'} %}{% endif %}<button type="submit">Create account</button></form>
{% endblock %}
