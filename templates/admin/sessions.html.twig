{% extends 'admin/layout.html.twig' %}
{% block title %}Sessions — Emailer Next{% endblock %}
{% block admin_body %}
<h1>Your active sessions</h1>
<p><a href="{{ path('admin_reauthenticate', {purpose: 'session_management'}) }}">Re-authenticate for session revocation</a></p>
<table><thead><tr><th>Session</th><th>Created</th><th>Last seen</th><th>Expiry</th><th>Action</th></tr></thead><tbody>
{% for session in sessions %}
<tr><td>{{ session.current ? 'Current session' : 'Other session' }}</td><td>{{ session.created_at }}</td><td>{{ session.last_seen_at }}</td><td>{{ session.absolute_expires_at }}</td><td>
<form method="post" action="{{ path('admin_session_revoke') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin-session-revoke') }}">
    <input type="hidden" name="session" value="{{ session.id_hash }}">
    <button type="submit">Revoke</button>
</form></td></tr>
{% else %}<tr><td colspan="5">No active sessions.</td></tr>{% endfor %}
</tbody></table>
{% endblock %}
