{% extends 'admin/layout.html.twig' %}
{% block title %}Re-authenticate — Emailer Next{% endblock %}
{% block admin_body %}
<h1>Confirm your identity</h1>
<p>This does not create or change a password. Enter your current account password again to confirm that it is you.</p>
<p>If MFA is enabled, enter the current six-digit code generated by your authenticator app, or one unused recovery code. Confirmation applies only to this browser session, only to the requested operation, and expires after five minutes.</p>
<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('admin-reauthenticate') }}">
    <input type="hidden" name="purpose" value="{{ purpose }}">
    <label>Current account password <input type="password" name="password" autocomplete="current-password" required></label>
    <label>Current authenticator code or unused recovery code <input type="text" name="mfa_code" autocomplete="one-time-code"></label>
    <button type="submit">Confirm current credentials</button>
</form>
{% endblock %}
